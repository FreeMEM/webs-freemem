[Unit]
Description=Webs de FreeMEM: guardar las descargas del día (contador de GitHub) y las visitas de cada web
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=webs
Group=webs
# para leer los registros de nginx (herramientas/visitas.py)
SupplementaryGroups=adm
ExecStart=/usr/bin/python3 /srv/webs-freemem/herramientas/descargas.py
